{
  "enabledPlugins": {
    "ruby-lsp@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Edit(**)",
      "Write(**)",
      "Bash(**)",
      "WebFetch(domain:github.com)"
    ],
    "deny": [
      "Edit(**/.vscode/*.json)",
      "Write(**/.vscode/*.json)",
      "Edit(**/.git/**)",
      "Write(**/.git/**)",
      "Edit(**/package.json)",
      "Write(**/package.json)",
      "Edit(**/package-lock.json)",
      "Write(**/package-lock.json)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Write(**/.env)",
      "Read(**/.*.key)",
      "Edit(**/.*.key)",
      "Write(**/.*.key)",
      "Edit(**/.gitattributes)",
      "Write(**/.gitattributes)",
      "Edit(**/web.config)",
      "Write(**/web.config)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(kill:*)",
      "Bash(ps:*)",
      "Bash(top:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(eval:*)",
      "Bash(xargs:*)",
      "Bash(jq:*)",
      "Bash(printenv:*)"
    ]
  }
}
